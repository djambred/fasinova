APP_NAME=FASINOVA
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=fasinova
DB_USERNAME=fasinova
DB_PASSWORD=secret






SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- FASINOVA ---
RUNNER_UID=1001
RUNNER_GID=1001
RUNNER_APPS_DIR=/home/runner/apps
DEPLOY_PORT_RANGE=20000-20999
# Caddy: sertifikat wildcard via DNS Cloudflare (CADDY_TLS=internal untuk dev)
CADDY_TLS=cloudflare
CLOUDFLARE_API_TOKEN=
CADDY_SOCKET_DIR=/run/fasinova
APP_DOMAIN=fasinova.test
GITHUB_ORG=
GITHUB_TOKEN=
TURNSTILE_SECRET=
TURNSTILE_SITE_KEY=
# Pendaftaran mandiri mahasiswa (/daftar): domain email yang diterima, pisahkan koma; kosong = semua domain
STUDENT_EMAIL_DOMAINS=student.esaunggul.ac.id

# Database untuk karya mahasiswa: server DB berjalan di daemon rootless `runner` (docker-compose.runner.yml)
KARYA_DB_ROOT_PASSWORD=ganti-password-admin-karya
